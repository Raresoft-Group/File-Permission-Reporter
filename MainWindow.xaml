<Window x:Class="FilePermissionReporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FilePermissionReporter.Models"
        Title="File Permission Reporter" Height="900" Width="1440" MinHeight="720" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WashBrush}">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:DirectoryNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Record.Name}" ToolTip="{Binding Record.Path}" Padding="2" />
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:AdMemberNode}" ItemsSource="{Binding Members}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding DisplayObjectType}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="  "/><TextBlock Text="{Binding Account}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
        </HierarchicalDataTemplate>
        <Style x:Key="DirectoryTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="2" />
            <Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="TitleText" Text="{DynamicResource AppTitle}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="{DynamicResource AppSubtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
            <Button x:Name="LanguageButton" Grid.Column="1" Content="EN" Click="LanguageButton_Click" VerticalAlignment="Center" MinWidth="72"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,9">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource RootPath}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="2,0,12,0"/>
                    <TextBox x:Name="RootPathBox" Grid.Column="1" Text="" ToolTip="D:\Share or \\fileserver\data" TextChanged="RootPathBox_TextChanged"/>
                    <Button x:Name="BrowseButton" Grid.Column="2" Content="{DynamicResource Browse}" Click="BrowseButton_Click" MinWidth="90"/>
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,7,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Depth}" VerticalAlignment="Center" Margin="4,0,5,0"/>
                    <TextBox x:Name="DepthBox" Text="3" Width="58" HorizontalContentAlignment="Center"/>
                    <CheckBox x:Name="UnlimitedCheck" Content="{DynamicResource Unlimited}" Checked="UnlimitedCheck_Changed" Unchecked="UnlimitedCheck_Changed"/>
                    <CheckBox x:Name="ShareCheck" Content="{DynamicResource IncludeShares}" Checked="ShareCheck_Changed" Unchecked="ShareCheck_Changed"/>
                    <CheckBox x:Name="AdCheck" Content="{DynamicResource ResolveGroups}"/>
                    <TextBlock x:Name="ShareNoticeText" Foreground="#B45D00" VerticalAlignment="Center" Margin="8,3" Visibility="Collapsed"/>
                </WrapPanel>
                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Parallelism}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                        <CheckBox x:Name="AutomaticConcurrencyCheck" Content="{DynamicResource Automatic}" IsChecked="True" Checked="AutomaticConcurrencyCheck_Changed" Unchecked="AutomaticConcurrencyCheck_Changed"/>
                        <Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="32" Value="8" Width="120" IsEnabled="False" VerticalAlignment="Center" ValueChanged="ConcurrencySlider_ValueChanged"/>
                        <TextBlock x:Name="ConcurrencyValueText" Text="Auto" VerticalAlignment="Center" MinWidth="36" Foreground="{StaticResource MutedBrush}"/>
                    </WrapPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="StartScanButton" Content="{DynamicResource StartScan}" Click="StartScanButton_Click" Background="{StaticResource BrandBrush}" Foreground="White" BorderBrush="{StaticResource BrandBrush}" MinWidth="110"/>
                        <Button x:Name="CancelScanButton" Content="{DynamicResource Cancel}" Click="CancelScanButton_Click" IsEnabled="False"/>
                        <Button x:Name="SaveReportButton" Content="{DynamicResource SaveReport}" Click="SaveReportButton_Click" IsEnabled="False" Background="#EAF0FF" Foreground="#2448AA"/>
                        <Button x:Name="OpenReportButton" Content="{DynamicResource OpenReport}" Click="OpenReportButton_Click" IsEnabled="False"/>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,9">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Progress}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,10,0"/>
                <ProgressBar x:Name="ScanProgressBar" Grid.Column="1" Height="13" IsIndeterminate="False" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                <TextBlock x:Name="AdMemberCountText" Grid.Column="2" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="3" Text="{DynamicResource Ready}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="12,0,4,0"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,9">
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,7,6"><StackPanel><TextBlock Text="{DynamicResource StartedAt}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StatStartedAt" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,7,6"><StackPanel><TextBlock Text="{DynamicResource RootPath}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StatRoot" Text="—" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=StatRoot}"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,7,6"><StackPanel><TextBlock Text="{DynamicResource DepthSummary}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StatDepth" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,6"><StackPanel><TextBlock Text="{DynamicResource Directories}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StatDirectories" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,7,0"><StackPanel><TextBlock Text="{DynamicResource Rules}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StatRules" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,7,0"><StackPanel><TextBlock Text="{DynamicResource Principals}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StatPrincipals" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,7,0"><StackPanel><TextBlock Text="{DynamicResource ExplicitRules}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StatExplicit" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11"><StackPanel><TextBlock Text="{DynamicResource InheritedRules}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StatInherited" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="4" Margin="0,0,0,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.34*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="0.66*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel><TextBlock Text="{DynamicResource DirectoryTree}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="ExpandAllButton" Content="{DynamicResource ExpandAll}" Padding="7,4" Click="ExpandAllButton_Click"/><Button x:Name="CollapseAllButton" Content="{DynamicResource CollapseAll}" Padding="7,4" Click="CollapseAllButton_Click"/></StackPanel></DockPanel>
                    <Grid Grid.Row="1" Margin="0,8,0,6"><TextBox x:Name="DirectorySearchBox" ToolTip="{DynamicResource SearchDirectories}" TextChanged="DirectorySearchBox_TextChanged"/><TextBlock x:Name="DirectorySearchHint" Text="{DynamicResource SearchDirectories}" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/></Grid>
                    <TreeView x:Name="DirectoryTree" Grid.Row="2" ItemContainerStyle="{StaticResource DirectoryTreeItemStyle}" SelectedItemChanged="DirectoryTree_SelectedItemChanged"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="0.34*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedPathText" Text="{DynamicResource NoScan}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=SelectedPathText}" FontSize="13" FontWeight="SemiBold" Margin="3,2,3,6"/>
                    <Grid Grid.Row="1" Margin="0,0,0,6"><TextBox x:Name="PermissionSearchBox" ToolTip="{DynamicResource SearchPermissions}" TextChanged="PermissionSearchBox_TextChanged"/><TextBlock x:Name="PermissionSearchHint" Text="{DynamicResource SearchPermissions}" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/></Grid>
                    <Grid Grid.Row="2"><DataGrid x:Name="PermissionGrid" SelectionChanged="PermissionGrid_SelectionChanged" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Account}" Binding="{Binding Identity}" Width="2.1*"/>
                            <DataGridTemplateColumn Header="{DynamicResource Rights}" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="rightsBadge" CornerRadius="5" Padding="7,2" Background="#EEF1F6"><TextBlock x:Name="rightsText" Text="{Binding DisplayRights}" FontWeight="SemiBold" Foreground="#48566B"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding RightsCategory}" Value="full"><Setter TargetName="rightsBadge" Property="Background" Value="#FFFFF0F0"/><Setter TargetName="rightsText" Property="Foreground" Value="#FFFF4D4F"/></DataTrigger><DataTrigger Binding="{Binding RightsCategory}" Value="modify"><Setter TargetName="rightsBadge" Property="Background" Value="#FFFFF4E5"/><Setter TargetName="rightsText" Property="Foreground" Value="#FFFA8C16"/></DataTrigger><DataTrigger Binding="{Binding RightsCategory}" Value="read"><Setter TargetName="rightsBadge" Property="Background" Value="#FFEFFBE8"/><Setter TargetName="rightsText" Property="Foreground" Value="#FF52C41A"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Type}" Binding="{Binding DisplayAccessType}" Width="0.8*"/>
                            <DataGridTextColumn Header="{DynamicResource Inherited}" Binding="{Binding DisplayInheritance}" Width="0.9*"/>
                        </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate><DataTemplate><Border Background="#F6F8FC" Padding="10" Margin="3"><WrapPanel><TextBlock Text="{DynamicResource RawRights}" FontWeight="Bold"/><TextBlock Text=": "/><TextBlock Text="{Binding RightsRaw}"/><TextBlock Text=" ["/><TextBlock Text="{Binding RightsMask}"/><TextBlock Text="]" Margin="0,0,14,0"/><TextBlock Text="{DynamicResource Sid}" FontWeight="Bold"/><TextBlock Text=": "/><TextBlock Text="{Binding Sid}" Margin="0,0,14,0"/><TextBlock Text="{DynamicResource InheritanceDetails}" FontWeight="Bold"/><TextBlock Text=": "/><TextBlock Text="{Binding InheritanceFlags}" Margin="0,0,6,0"/><TextBlock Text="/" Margin="0,0,6,0"/><TextBlock Text="{Binding PropagationFlags}"/></WrapPanel></Border></DataTemplate></DataGrid.RowDetailsTemplate>
                    </DataGrid><TextBlock x:Name="PermissionEmptyText" Text="{DynamicResource NoPermissions}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
                    <TextBlock x:Name="GroupMembersTitle" Grid.Row="3" Text="{DynamicResource GroupMembers}" FontWeight="Bold" Margin="3,7,3,3" Visibility="Collapsed"/>
                    <TreeView x:Name="GroupMembersTree" Grid.Row="4" Visibility="Collapsed" BorderThickness="0"><TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type models:AdMemberNode}" ItemsSource="{Binding Members}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding DisplayObjectType}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="  "/><TextBlock Text="{Binding Account}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></HierarchicalDataTemplate></TreeView.Resources></TreeView>
                </Grid>
            </Border>
        </Grid>

        <TabControl Grid.Row="5" Background="White">
            <TabItem Header="{DynamicResource Shares}"><DataGrid x:Name="ShareGrid" Margin="4"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Name}" Binding="{Binding ShareName}" Width="1*"/><DataGridTextColumn Header="{DynamicResource SharePath}" Binding="{Binding SharePath}" Width="2*"/><DataGridTextColumn Header="{DynamicResource Account}" Binding="{Binding Account}" Width="2*"/><DataGridTextColumn Header="{DynamicResource ShareRight}" Binding="{Binding AccessRight}" Width="1*"/><DataGridTextColumn Header="{DynamicResource Type}" Binding="{Binding AccessType}" Width="1*"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="{DynamicResource Warnings}"><DataGrid x:Name="IssueGrid" Margin="4"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Stage}" Binding="{Binding Stage}" Width="0.7*"/><DataGridTextColumn Header="{DynamicResource Path}" Binding="{Binding Path}" Width="2*"/><DataGridTextColumn Header="{DynamicResource Message}" Binding="{Binding Message}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
        </TabControl>
    </Grid>
</Window>
