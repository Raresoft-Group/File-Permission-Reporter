<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FilePermissionReporter</AssemblyName>
    <RootNamespace>FilePermissionReporter</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\FilePermissionReporter.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.0" />
    <None Update="README.md" CopyToPublishDirectory="Always" />
    <None Update="README-CN.md" CopyToPublishDirectory="Always" />
    <None Update="LICENSE" CopyToPublishDirectory="Always" />
    <None Update="Assets/FilePermissionReporter.png" CopyToPublishDirectory="Always" />
    <None Update="docs/RELEASE_NOTES_1.0.0.md" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
